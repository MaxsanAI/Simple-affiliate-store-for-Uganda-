---
import { getRawProducts, getAutomatedCategories } from '../utils/csvLoader';
const products = getRawProducts();
const categories = getAutomatedCategories();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI HUB STORE 🛒</title>
    <style>
      body { font-family: system-ui, -apple-system, sans-serif; max-width: 1200px; margin: 0 auto; padding: 20px; background: #f8f9fa; }
      h1 { text-align: center; margin-bottom: 30px; font-weight: 800; }
      nav { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px; justify-content: center; }
      nav a { text-decoration: none; color: #495057; font-weight: 600; padding: 8px 16px; border-radius: 6px; background: #e9ecef; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 25px; }
      .card { background: white; padding: 20px; border-radius: 12px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; }
      .media-container { width: 100%; height: 200px; margin-bottom: 15px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #f0f0f0; cursor: pointer; }
      .card img, .lazy-video { max-width: 100%; max-height: 100%; object-fit: contain; }
      .card h3 { font-size: 0.95rem; margin: 10px 0; height: 55px; overflow: hidden; color: #333; }
      .price { font-size: 1.25rem; font-weight: bold; color: #198754; margin: 10px 0; }
      .btn { display: block; background: #0d6efd; color: white; padding: 12px; text-decoration: none; border-radius: 6px; font-weight: bold; }
    </style>
  </head>
  <body>
    <h1>AI HUB STORE</h1>
    <nav>
      <a href="/">All Products</a>
      {categories.map((cat) => <a href={`/kategorija/${cat.id}`}>{cat.name}</a>)}
    </nav>
    <div class="grid" id="products-grid">
      {products.map((product) => (
        <div class="card">
          <div>
            <div class="media-container" onclick="playVideo(this)">
              {product.videoUrl ? (
                <video data-src={product.videoUrl} class="lazy-video" loop muted playsinline poster={product.imageUrl}></video>
              ) : (
                <img src={product.imageUrl} alt={product.title} loading="lazy" />
              )}
            </div>
            <h3>{product.title}</h3>
          </div>
          <div>
            <p class="price">{product.price}</p>
            <a href={product.affiliateUrl} target="_blank" rel="noopener noreferrer" class="btn">Buy Now</a>
          </div>
        </div>
      ))}
    </div>
    <script is:inline>
      function playVideo(container) {
        const video = container.querySelector('.lazy-video');
        if (!video) return;
        if (!video.src) video.src = video.dataset.src;
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      }
    </script>
  </body>
</html>
